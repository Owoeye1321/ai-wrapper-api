{
  "scripts": {
    "start": "node -r tsconfig-paths/register -r dotenv/config build/index.js",
    "build": "tsc",
    "nodemon": "nodemon --watch 'src/**/*.ts' --ignore 'src/**/*.spec.ts' -r tsconfig-paths/register -r dotenv/config --exec ts-node --files src/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "groq-sdk": "^0.36.0",
    "http-status": "^2.1.0",
    "install": "^0.13.0",
    "joi": "^18.0.2",
    "nodemon": "^3.1.11",
    "npm": "^11.6.3",
    "openai": "^6.9.1",
    "tsc": "^2.0.4",
    "typescript": "^5.9.3",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsconfig-paths": "^4.2.0"
  }
}
