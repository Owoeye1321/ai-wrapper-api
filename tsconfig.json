{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop":false,  // Turn this OFF for ESM
    "target": "es2020",         // ES2020+ for modern JS
    "module": "esnext",         // Use ESM output instead of commonjs
    "noImplicitAny": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "outDir": "build",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./*"]
    },
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "src/models/.model.ts"],
  "exclude": ["build", "node_modules"]
}